# Esta etapa solo descarga dependencias. La imagen composer:2 cambia de versión de PHP por su cuenta
# (ya trae 8.6) y Composer rechazaría paquetes que declaran soporte hasta 8.5. El PHP real de producción
# es el de la etapa final (8.5.12), así que aquí se ignoran los requisitos de plataforma.
FROM composer:2.9.5 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --ignore-platform-reqs
COPY . .
RUN composer dump-autoload --no-dev --optimize

# Misma versión de PHP que el Dockerfile de desarrollo.
FROM php:8.6.0RC5-fpm

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx supervisor libzip-dev libpng-dev libjpeg-dev libwebp-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install pdo_mysql zip bcmath pcntl gd \
    && rm -rf /var/lib/apt/lists/*

COPY docker/prod/nginx.conf /etc/nginx/sites-available/default
COPY docker/prod/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/prod/php.ini /usr/local/etc/php/conf.d/zz-prod.ini

WORKDIR /var/www/html
COPY --from=vendor /app .
RUN chown -R www-data:www-data storage bootstrap/cache

EXPOSE 80

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
